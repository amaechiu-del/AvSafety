{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrators",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "admins/{userId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Authorized administrators by user ID"
    }
  }
}
